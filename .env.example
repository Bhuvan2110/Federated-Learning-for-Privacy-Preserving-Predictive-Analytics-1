# ─────────────────────────────────────────────────────────────
# FedShield — environment configuration
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────

# Google AI Studio Agent (Gemini)
# Get a key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=
# Model: gemini-2.5-flash | gemini-2.5-pro | gemini-3.6-flash | gemini-3.5-flash | gemini-1.5-flash
VITE_GEMINI_MODEL=gemini-2.5-flash

# Legacy / Qwen3 compatibility fallback
VITE_QWEN_API_KEY=
VITE_QWEN_REGION=intl
VITE_QWEN_MODEL=qwen-plus

# Real Google Sign-In (Google Identity Services / OAuth 2.0)
VITE_GOOGLE_CLIENT_ID=

# Firebase Authentication & Infrastructure (fedshield-25be4)
# Copy your web app config from: https://console.firebase.google.com/u/1/project/fedshield-25be4/settings/general
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fedshield-25be4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fedshield-25be4
VITE_FIREBASE_STORAGE_BUCKET=fedshield-25be4.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
