# ─────────────────────────────────────────────────────────────
# FedShield — environment configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit .env or hard-code keys in source.
# ─────────────────────────────────────────────────────────────

# Qwen3 AI assistant (Alibaba Cloud DashScope, OpenAI-compatible)
# Get a key at: https://dashscope.console.aliyun.com/  (Model Studio → API-KEY)
VITE_QWEN_API_KEY=
# Region: "intl" (dashscope-intl.aliyuncs.com) or "cn" (dashscope.aliyuncs.com)
VITE_QWEN_REGION=intl
# Model: qwen-plus | qwen-turbo | qwen-max | qwen3-32b | qwen3-14b | qwen3-8b | qwen3-4b
VITE_QWEN_MODEL=qwen-plus

# Real Google Sign-In (Google Identity Services / OAuth 2.0)
# Create an OAuth client at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins must include your dev/prod origin (e.g. http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=

# Firebase (optional — swap the demo auth adapter for the real SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
