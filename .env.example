# ─────────────────────────────────────────────────────────────
# FedShield — environment configuration
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────

# Google AI Studio Agent (Gemini)
# Get a key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=
# Model: gemini-2.5-flash | gemini-2.5-pro | gemini-3.6-flash | gemini-3.5-flash | gemini-1.5-flash
VITE_GEMINI_MODEL=gemini-2.5-flash

# Legacy / Qwen3 compatibility fallback
VITE_QWEN_API_KEY=
VITE_QWEN_REGION=intl
VITE_QWEN_MODEL=qwen-plus

# Real Google Sign-In (Google Identity Services / OAuth 2.0)
VITE_GOOGLE_CLIENT_ID=

# Appwrite Cloud Backend Infrastructure (Singapore Region)
# Console: https://cloud.appwrite.io/console/project-sgp-6a8d39cc003c737ffa46/get-started
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a8d39cc003c737ffa46
VITE_APPWRITE_DATABASE_ID=fedshield_db
VITE_APPWRITE_RUNS_COLLECTION_ID=runs
VITE_APPWRITE_PREDICTIONS_COLLECTION_ID=predictions

